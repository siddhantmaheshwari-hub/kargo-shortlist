# Supabase: Project Settings -> API. Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=                # not used by the server (RLS blocks anon); kept for reference
SUPABASE_SERVICE_ROLE_KEY=        # required: the server reads/writes with this key

# Gemini (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend. Leave RESEND_API_KEY blank and every email is saved as a draft in /outbox.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kargo Hiring <onboarding@resend.dev>
TEST_RECIPIENT_EMAIL=             # optional: if set, ALL emails go here instead of candidates
SCHEDULING_LINK=                  # optional: included in interview invites

# Password gate for the whole app (required in production; username can be anything)
APP_PASSWORD=

FOUNDER_NAME=Arjun Mehta
COMPANY_NAME=Kargo
