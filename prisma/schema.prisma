// Kargo hiring shortlist — schema.
// Kept Postgres-compatible: enums are stored as String and JSON as String
// (SQLite has neither). Swap the provider and these become native types later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id           String        @id @default(cuid())
  code         String        @unique // PM | SPM
  title        String
  jdText       String
  openedAt     DateTime
  applications Application[]
}

model Candidate {
  id               String        @id @default(cuid())
  name             String
  email            String?       @unique
  phone            String?
  location         String?
  relocationStated Boolean?
  createdAt        DateTime      @default(now())
  applications     Application[]
}

model Application {
  id             String    @id @default(cuid())
  candidateId    String
  roleId         String
  sourceFile     String
  cvText         String
  receivedAt     DateTime  @default(now())
  firstOpenedAt  DateTime?
  status         String    @default("NEW") // NEW | SCORED | DECIDED | EMAILED | ERROR
  pmTotal        Int?
  spmTotal       Int?
  band           String? // SHORTLIST | SECOND_LOOK | DECLINE_RECOMMENDED
  overridesFired String? // JSON array of rule names
  crossRouteFlag String? // RECOMMEND_FOR_PM | CONSIDER_FOR_SPM
  oneLineSummary String?
  // Audit trail for reproducibility (Section 6.1)
  rawExtraction  String?
  scoredModel    String?
  rubricVersion  String?

  candidate Candidate        @relation(fields: [candidateId], references: [id])
  role      Role             @relation(fields: [roleId], references: [id])
  scores    CriterionScore[]
  brief     Brief?
  decisions Decision[]
  emails    EmailMessage[]

  @@unique([candidateId, roleId])
}

model CriterionScore {
  id            String  @id @default(cuid())
  applicationId String
  rubric        String // PM | SPM
  criterion     String // A | B | C | D
  score         Int
  unclear       Boolean @default(false)
  evidenceQuote String?
  reasoning     String?
  quoteVerified Boolean @default(false)
  rubricVersion String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, rubric, criterion, rubricVersion])
}

model Brief {
  id             String   @id @default(cuid())
  applicationId  String   @unique
  whoTheyAre     String
  whyRanked      String
  probes         String // JSON
  crossRouteNote String?
  generatedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Decision {
  id            String    @id @default(cuid())
  applicationId String
  outcome       String // ADVANCE | DECLINE | HOLD
  forRole       String // PM | SPM
  note          String?
  decidedAt     DateTime  @default(now())
  undoneAt      DateTime?

  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  emails      EmailMessage[]
}

model EmailMessage {
  id             String    @id @default(cuid())
  applicationId  String
  decisionId     String
  type           String // ADVANCE | DECLINE | BACKLOG_DECLINE | BACKLOG_ADVANCE
  toIntended     String
  toActual       String
  subject        String
  body           String
  status         String    @default("SCHEDULED") // SCHEDULED | SENT | CANCELLED | FAILED
  scheduledFor   DateTime
  sentAt         DateTime?
  resendId       String?
  idempotencyKey String
  error          String?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decision    Decision    @relation(fields: [decisionId], references: [id])

  @@index([status, scheduledFor])
}

model PastHire {
  id        String   @id @default(cuid())
  name      String   @unique
  roleHired String
  joinedAt  DateTime
  rating    String // EXCEEDS | MEETS | BELOW
  cvText    String
}

model CalibrationRun {
  id            String   @id @default(cuid())
  runAt         DateTime @default(now())
  model         String
  rubricVersion String
  results       String // JSON
  passed        Boolean
}

model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actor    String // system | arjun
  action   String
  entity   String
  entityId String?
  detail   String? // JSON

  @@index([entity, entityId])
  @@index([at])
}
